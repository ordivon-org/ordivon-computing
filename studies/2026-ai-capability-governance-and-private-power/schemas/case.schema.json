{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/research/ai-capability-governance/case.schema.json",
  "title": "AI capability-governance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "title",
    "status",
    "observedAt",
    "unit",
    "actors",
    "resources",
    "claims",
    "relations",
    "evidenceRefs",
    "counterfactuals",
    "unresolved",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "caseId": {"type": "string", "pattern": "^case:[a-z0-9][a-z0-9:._-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "status": {"enum": ["hypothetical", "draft", "observed", "completed", "superseded"]},
    "observedAt": {"type": "string", "format": "date"},
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "surface", "model", "accessTier", "region", "retentionMode"],
      "properties": {
        "providerId": {"type": "string", "minLength": 1},
        "surface": {"enum": ["consumer-chat", "api", "coding-agent", "enterprise", "cloud-marketplace", "verified-access", "open-weights", "self-hosted", "other"]},
        "model": {"type": "string", "minLength": 1},
        "modelRevision": {"type": ["string", "null"]},
        "accessTier": {"type": "string", "minLength": 1},
        "organizationClass": {"type": ["string", "null"]},
        "region": {"type": "string", "minLength": 1},
        "retentionMode": {"type": "string", "minLength": 1},
        "policyRevisionRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/actor"}
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resource"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "evidenceRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "counterfactuals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "unresolved": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsPersonalData", "redactions"],
      "properties": {
        "containsPersonalData": {"type": "boolean"},
        "redactions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "powerDimension": {
      "enum": ["normative", "observational", "enforcement", "adjudicative", "infrastructural", "epistemic"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "type", "label"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "Provider",
            "ModelDeveloper",
            "Model",
            "CloudProvider",
            "ComputeProvider",
            "ToolProvider",
            "ApplicationHost",
            "Organization",
            "User",
            "Researcher",
            "Agent",
            "State",
            "Regulator",
            "Court",
            "Auditor",
            "StandardsBody",
            "OpenSourceMaintainer",
            "AffectedThirdParty",
            "Community"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "jurisdiction": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "type", "label"],
      "properties": {
        "resourceId": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "ModelCapability",
            "ModelWeights",
            "InferenceAccess",
            "TrainingAccess",
            "Compute",
            "CloudWorkload",
            "Account",
            "OrganizationTenant",
            "Identity",
            "RegionEligibility",
            "Data",
            "RetentionState",
            "ConversationState",
            "TaskState",
            "Context",
            "ToolCatalog",
            "ToolAuthority",
            "ResourceAuthority",
            "EffectAuthority",
            "Trace",
            "Evidence",
            "AppealChannel",
            "DistributionChannel",
            "PaymentChannel",
            "Reputation"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "ownerActorId": {"type": ["string", "null"]},
        "portability": {"enum": ["unknown", "none", "partial", "full"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "class",
        "statement",
        "confidence",
        "evidenceRefs",
        "counterEvidenceRefs",
        "assumptions",
        "falsifier",
        "unresolved"
      ],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "class": {"enum": ["D", "C", "N", "A"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "counterEvidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "falsifier": {"type": "string", "minLength": 1, "maxLength": 4000},
        "unresolved": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "subjectId", "predicate", "objectId", "powerDimensions", "evidenceRefs"],
      "properties": {
        "relationId": {"type": "string", "minLength": 1},
        "subjectId": {"type": "string", "minLength": 1},
        "predicate": {
          "enum": [
            "defines",
            "revises",
            "interprets",
            "observes",
            "classifies",
            "licenses",
            "conditions",
            "allows",
            "restricts",
            "degrades",
            "revokes",
            "retains",
            "reports",
            "exempts",
            "appeals_to",
            "reviews",
            "audits",
            "regulates",
            "delegates_to",
            "depends_on",
            "can_substitute_with",
            "locks_in",
            "ports_to",
            "benefits",
            "burdens",
            "harms",
            "protects",
            "causes",
            "enables",
            "blocks",
            "contradicts",
            "supersedes"
          ]
        },
        "objectId": {"type": "string", "minLength": 1},
        "powerDimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/powerDimension"}, "uniqueItems": true},
        "mechanism": {"type": ["string", "null"], "maxLength": 4000},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
