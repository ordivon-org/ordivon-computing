{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/content/project-v1.schema.json",
  "title": "Ordivon project content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "repository", "kind", "default_profiles", "documentation_roots", "managed_paths", "enforcement", "maintainers"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^ordivon-[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "format": "uri"},
    "kind": {"enum": ["research", "engineering", "research-engineering", "publication", "adapter", "mixed"]},
    "default_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["engineering", "research", "publication", "provider", "organization"]}},
    "documentation_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "managed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "enforcement": {"enum": ["advisory", "strict"]},
    "maintainers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "public_projection": {"type": "string"},
    "description": {"type": "string"}
  }
}
