{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/content/check-receipt-v1.schema.json",
  "title": "Ordivon content check receipt v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "capturedAt", "projectId", "mode", "contentState", "checkedDocuments", "managedDocuments", "metadataDocuments", "blockingFailures", "warnings", "issues", "metrics", "receiptDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon-content-check"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "projectId": {"type": "string"},
    "mode": {"enum": ["advisory", "strict"]},
    "contentState": {"enum": ["BLOCKED", "DEGRADED", "READY"]},
    "checkedDocuments": {"type": "integer", "minimum": 0},
    "managedDocuments": {"type": "integer", "minimum": 0},
    "metadataDocuments": {"type": "integer", "minimum": 0},
    "blockingFailures": {"type": "integer", "minimum": 0},
    "warnings": {"type": "integer", "minimum": 0},
    "issues": {"type": "array"},
    "metrics": {"type": "object"},
    "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
