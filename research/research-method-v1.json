  },
  "kind": "ordivon.agent-first-research-method",
  "loop": [
    {
      "gate": "evidence_refs_bind_observed_work",
      "goal": "Find repeated work, failure, recovery, or human intervention in real Agent trajectories.",
      "outputs": [
        "BurdenObservation"
      ],
      "stage": "OBSERVE"
    },
    {
      "gate": "current_carrier_and_failure_consequence_are_explicit",
      "goal": "Identify the current carrier of the responsibility and whether that placement is structural or accidental.",
      "outputs": [
        "ResponsibilityPlacement"
      ],
      "stage": "PLACE_RESPONSIBILITY"
    },
    {
      "gate": "baseline_minimal_candidate_falsifier_and_rollback_are_explicit",
      "goal": "Specify the smallest external structure that could remove the burden without taking product authority.",
      "outputs": [
        "ExternalizationHypothesis"
      ],
      "stage": "PROPOSE_EXTERNALIZATION"
    },
    {
      "gate": "admission_gates_pass",
      "goal": "Reject candidates that duplicate mature substrate, hide authority, cannot be measured, or cost more to maintain than the burden they target.",
      "outputs": [
        "AdmissionRecord"
      ],
      "stage": "PREFLIGHT"
    },
    {
      "gate": "formal_trial_or_equivalent_domain_evidence_is_valid",
      "goal": "Run the smallest controlled comparison using owner-native evidence and independent outcome checks.",
      "outputs": [
        "experiment_and_trial_refs"
      ],
      "stage": "EXPERIMENT"
    },
    {
      "gate": "decision_cites_benefit_cost_failure_and_limitations",
      "goal": "Retain, narrow, defer, or delete the candidate from evidence rather than narrative preference.",
      "outputs": [
        "ExternalizationDecision"
      ],
      "stage": "DISPOSE"
    },
    {
      "gate": "no_new_authority_is_created_without_owner_admission",
      "goal": "Move a proven capability downward into the narrowest reusable layer, or remove the candidate and preserve the negative evidence.",
      "outputs": [
        "knowledge_or_core_candidate_ref",
        "portfolio_update_proposal"
      ],
      "stage": "SINK_OR_REMOVE"
    }
  ],
  "methodId": "AFR-M1-001",
  "primaryMetrics": [
    "verified_task_or_domain_outcome",
    "false_completion",
    "duplicate_or_unknown_effect",
    "tool_argument_rejection",
    "repeated_reads_or_reconstruction",
    "context_tokens",
    "model_calls",
    "human_interruptions",
    "recovery_work",
    "wall_time",
    "durable_state_and_maintenance_cost"
  ],
  "principles": [
    "agent_is_default_research_operator",
    "human_attention_is_reserved_for_purpose_consequence_and_boundary_change",
    "owner_native_facts_remain_authoritative",
    "externalization_is_a_hypothesis_not_a_presumption",
    "strong_classical_and_simpler_agent_baselines_precede_new_structure",
    "probabilistic_models_should_not_repeatedly_reconstruct_stable_formalizable_structure",
    "negative_null_and_deletion_results_are_first_class",
    "research_records_reference_product_authority_instead_of_copying_it",
    "no_raw_private_chain_of_thought_is_required"
  ],
  "prohibitions": [
    "research_method_becomes_product_authority",
    "automatic_product_merge_or_deployment_from_research_score",
    "universal_scalar_intelligence_score",
    "new_memory_graph_world_or_orchestrator_from_conceptual_appeal_alone",
    "raw_private_reasoning_as_required_evidence",
    "retaining_structure_because_it_was_expensive_to_build",
    "human_review_as_a_default_step_for_reversible_private_research"
  ],
  "purpose": "Turn observed Agent work burdens and misplaced responsibilities into falsifiable externalization experiments, then retain only structures that improve real work with lower total recurring cost.",
