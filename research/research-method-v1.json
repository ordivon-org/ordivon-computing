  "firstConsumers": [
    {
      "consumer": "research/experiments/experiment-loop-v0",
      "purpose": "Replace human-managed routine experiment progression with bounded Agent-led burden-to-externalization research while preserving evaluator and owner authority."
    },
    {
      "consumer": "ordivon-computing reform",
      "purpose": "Re-audit existing Computer structures by responsibility placement and measured Agent burden before changing product architecture."
    }
  ],
  "humanAttentionTriggers": [
    "purpose_change",
