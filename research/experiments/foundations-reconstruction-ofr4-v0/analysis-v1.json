  "dispositionReason": [
    "No compressed treatment satisfies the frozen semantic gates on holdout.",
    "The raw selector chooses full_eight_role, but its action/reopen submetric is measurement-invalid because it conflates research reopening, rival admission and evidence trust.",
    "full_eight_role has severe representation-correlated missingness: 4/12 accepted holdout trials across only 3/6 holdout cases, so its perfect survivor role score is not sufficient generalization evidence.",
    "winner_only is strongly falsified as a causal representation despite best realization reliability."
  ],
  "measurementValidity": {
    "reopenDecision": {
      "validForSelection": false,
      "reason": "The task collapsed research-question reopening, old-rival admission, and sufficiency/trust of a new textual evidence claim into one REOPEN/KEEP_CLOSED bit. Accepted Workstation/Security answers could reconstruct causal roles yet rationally treat the probe as an already-permitted boundary case; Finance answers sometimes refused to treat an unproven prose assertion as verified evidence. The target therefore mixes Theory, Evidence, and Authority."
    },
    "roleReconstruction": {
      "validForSelection": false,
      "reason": "Role grades remain useful conditional semantic evidence, but full_eight_role had only 4/12 accepted physical holdout trials covering 3/6 holdout owners; missingness is representation-correlated and not safely ignorable."
    },
    "realizationReliability": {
      "validObservation": true,
      "causalAttribution": "suggestive-not-established",
      "reason": "All 15 holdout semantic failures occurred at generation realization (mostly no_progress); every generated valid answer obtained a valid judge result. Acceptance differs strongly by treatment, but N is too small and case/treatment interactions remain."
    },
    "cost": {
      "validObservation": true,
      "reason": "Provider-reported prompt/completion/total tokens are exact physical evidence for admitted calls. Compression savings are smaller at full request level than packet word-count savings because fixed instructions/schema dominate and omitted semantics can move work into completion."
    }
  },
