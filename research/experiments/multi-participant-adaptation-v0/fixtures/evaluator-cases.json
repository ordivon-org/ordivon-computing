{
  "schemaVersion": 1,
  "kind": "ordivon.p4-hidden-evaluator-cases",
  "casesByScenario": {
    "stable-top-k": [
      {
        "args": [
          [
            {
              "id": "z",
              "score": 5
            },
            {
              "id": "a",
              "score": 5
            },
            {
              "id": "m",
              "score": 4
            }
          ],
          2
        ],
        "expected": [
          "z",
          "a"
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            {
              "id": "a",
              "score": 1
            }
          ],
          -1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "id": "a",
              "score": 2
            },
            {
              "id": "b",
              "score": 1
            }
          ],
          5
        ],
        "expected": [
          "a",
          "b"
        ],
        "preserveArgs": true
      }
    ],
    "merge-intervals": [
      {
        "args": [
          [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        ],
        "expected": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            [
              5,
              5
            ],
            [
              1,
              2
            ],
            [
              2,
              6
            ]
          ]
        ],
        "expected": [
          [
            1,
            6
          ]
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            [
              3,
              1
            ]
          ]
        ],
        "raises": "ValueError"
      }
    ],
    "largest-remainder": [
      {
        "args": [
          0,
          [
            0,
            0
          ]
        ],
        "expected": [
          0,
          0
        ],
        "preserveArgs": true
      },
      {
        "args": [
          5,
          [
            0,
            0
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          7,
          [
            2,
            2,
            1
          ]
        ],
        "expected": [
          3,
          3,
          1
        ]
      },
      {
        "args": [
          10000000000000003,
          [
            1,
            2,
            3
          ]
        ],
        "expected": [
          1666666666666667,
          3333333333333334,
          5000000000000002
        ]
      }
    ],
    "dedupe-events": [
      {
        "args": [
          [
            {
              "id": "a",
              "seq": 2,
              "payload": "old"
            },
            {
              "id": "b",
              "seq": 1,
              "payload": "b"
            },
            {
              "id": "a",
              "seq": 2,
              "payload": "new"
            }
          ]
        ],
        "expected": [
          {
            "id": "b",
            "seq": 1,
            "payload": "b"
          },
          {
            "id": "a",
            "seq": 2,
            "payload": "new"
          }
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            {
              "id": "x",
              "seq": 5,
              "payload": 1
            },
            {
              "id": "y",
              "seq": 5,
              "payload": 2
            }
          ]
        ],
        "expected": [
          {
            "id": "x",
            "seq": 5,
            "payload": 1
          },
          {
            "id": "y",
            "seq": 5,
            "payload": 2
          }
        ]
      }
    ],
    "apply-edits": [
      {
        "args": [
          "abcdefgh",
          [
            {
              "start": 5,
              "end": 7,
              "replacement": "Y"
            },
            {
              "start": 1,
              "end": 3,
              "replacement": "X"
            }
          ]
        ],
        "expected": "aXdeYh",
        "preserveArgs": true
      },
      {
        "args": [
          "abcd",
          [
            {
              "start": 1,
              "end": 2,
              "replacement": "X"
            },
            {
              "start": 2,
              "end": 3,
              "replacement": "Y"
            }
          ]
        ],
        "expected": "aXYd"
      },
      {
        "args": [
          "abcd",
          [
            {
              "start": 1,
              "end": 3,
              "replacement": "X"
            },
            {
              "start": 2,
              "end": 4,
              "replacement": "Y"
            }
          ]
        ],
        "raises": "ValueError"
      }
    ],
    "quorum-decision": [
      {
        "args": [
          [
            "yes",
            "abstain",
            "abstain"
          ],
          2
        ],
        "expected": "no-quorum",
        "preserveArgs": true
      },
      {
        "args": [
          [
            "yes",
            "no"
          ],
          2
        ],
        "expected": "tie"
      },
      {
        "args": [
          [
            "maybe"
          ],
          1
        ],
        "raises": "ValueError"
      }
    ],
    "chunk-windows": [
      {
        "args": [
          [
            1,
            2,
            3,
            4,
            5
          ],
          3,
          1
        ],
        "expected": [
          [
            1,
            2,
            3
          ],
          [
            3,
            4,
            5
          ],
          [
            5
          ]
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            1,
            2
          ],
          3,
          0
        ],
        "expected": [
          [
            1,
            2
          ]
        ]
      },
      {
        "args": [
          [
            1,
            2,
            3
          ],
          2,
          2
        ],
        "raises": "ValueError"
      }
    ],
    "select-latest": [
      {
        "args": [
          [
            {
              "key": "a",
              "revision": 2,
              "observed": 1,
              "value": "old"
            },
            {
              "key": "a",
              "revision": 2,
              "observed": 3,
              "value": "new"
            }
          ]
        ],
        "expected": [
          {
            "key": "a",
            "revision": 2,
            "observed": 3,
            "value": "new"
          }
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            {
              "key": "a",
              "revision": 2,
              "observed": 3,
              "value": "x"
            },
            {
              "key": "a",
              "revision": 2,
              "observed": 3,
              "value": "y"
            }
          ]
        ],
        "expected": [
          {
            "key": "a",
            "revision": 2,
            "observed": 3,
            "value": "y"
          }
        ]
      },
      {
        "args": [
          [
            {
              "key": "a",
              "revision": -1,
              "observed": 0,
              "value": 0
            }
          ]
        ],
        "raises": "ValueError"
      }
    ],
    "normalize-tags": [
      {
        "args": [
          [
            "b",
            " A ",
            "B",
            "a",
            "c"
          ]
        ],
        "expected": [
          "b",
          "A",
          "c"
        ],
        "preserveArgs": true
      },
      {
        "args": [
          [
            "Straße",
            "STRASSE"
          ]
        ],
        "expected": [
          "Straße"
        ]
      },
      {
        "args": [
          [
            "ok",
            "   "
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            1
          ]
        ],
        "raises": "ValueError"
      }
    ]
  }
}
