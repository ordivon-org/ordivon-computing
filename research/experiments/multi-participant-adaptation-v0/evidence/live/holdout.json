          "source": "def chunk_windows(items, size, overlap):\n    if size <= 0 or not (0 <= overlap < size):\n        raise ValueError(\"invalid\")\n    if not items:\n        return []\n    step = size - overlap\n    windows = []\n    i = 0\n    while i < len(items):\n        windows.append(items[i:i+size])\n        i += step\n    return windows",
