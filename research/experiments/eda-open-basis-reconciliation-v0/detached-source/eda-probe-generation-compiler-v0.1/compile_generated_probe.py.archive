#!/usr/bin/env python3
from __future__ import annotations
import argparse,hashlib,json
from pathlib import Path

def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 ap=argparse.ArgumentParser(); ap.add_argument('--enumeration',required=True); ap.add_argument('--allowed-kind',action='append',required=True); ap.add_argument('--output',required=True); a=ap.parse_args(); E=json.load(open(a.enumeration)); allowed=set(a.allowed_kind); rows=[]
 for c in E['candidates']:
  if c['kind'] not in allowed: continue
  f=c['features']; conn=f['connectivityPreserved'] and f['ercElectricalClean']; exact=conn and not f['targetNetNameChanged']; sep=(conn!=exact)
  if sep: rows.append({'candidateId':c['id'],'kind':c['kind'],'args':c['args'],'editCost':1,'relationProjection':{'erc.electrical_clean':{'pass':f['ercElectricalClean']},'functional.connectivity':{'pass':f['connectivityPreserved']},'representation.net_name_changed':{'pass':f['targetNetNameChanged']},'hypothesis_separation':{'H_connectivity_semantic':'accept' if conn else 'reject','H_exact_net_name':'accept' if exact else 'reject'}},'evidenceDigest':'sha256:'+hashlib.sha256(json.dumps(c['observation'],sort_keys=True,separators=(',',':')).encode()).hexdigest()})
 if not rows:
  status='no_discriminator_in_generation_basis'; selected=None; equiv=False
 else:
  # all candidates equivalent iff their declared responsibility projection (excluding identity/args) matches exactly
  def key(r): return json.dumps(r['relationProjection'],sort_keys=True,separators=(',',':'))
  equiv=len({key(r) for r in rows})==1
  status='equivalent_discriminator_family' if equiv else 'multiple_consequence_distinct_discriminators'
  selected=sorted(rows,key=lambda r:(r['editCost'],r['candidateId']))[0] if equiv else None
 out={'schemaVersion':1,'kind':'ordivon.aeb.eda-generated-probe-closure','sourceEnumerationSha256':sha(a.enumeration),'allowedMutationKinds':sorted(allowed),'status':status,'discriminatorCount':len(rows),'outcomeEquivalent':equiv,'selectedCandidateId':selected['candidateId'] if selected else None,'selectedCandidate':selected,'candidates':rows,'agentRequired':False if equiv or not rows else True,'standingBoundary':'selection only over provider-observed candidates generated by declared mutation kinds; absence means generation basis insufficient, not no possible discriminator exists'}; Path(a.output).write_text(json.dumps(out,indent=2,sort_keys=True)+'\n'); print(json.dumps({'status':status,'count':len(rows),'equivalent':equiv,'selected':out['selectedCandidateId'],'agentRequired':out['agentRequired']},sort_keys=True)); raise SystemExit(0 if rows else 10)
if __name__=='__main__': main()
