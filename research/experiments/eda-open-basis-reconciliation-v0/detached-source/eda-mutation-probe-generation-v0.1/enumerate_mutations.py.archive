#!/usr/bin/env python3
from __future__ import annotations
import argparse,hashlib,json,re,shutil,subprocess,tempfile
from pathlib import Path
K='/root/.local/share/ordivon/laboratory/providers/kicad-10.0.5-appimage-lite/bin/kicad-cli'
TARGET=['R1.1','U1.1','U1.7']

def forms(text, marker):
 for m in re.finditer(marker,text,re.M):
  a=m.start(); dep=0
  for i in range(a,len(text)):
   if text[i]=='(': dep+=1
   elif text[i]==')':
    dep-=1
    if dep==0: yield a,i+1,text[a:i+1]; break

def nmap(text):
 out={}
 for _,_,b in forms(text,r'^\s*\(net\s'):
  nm=re.search(r'\(name\s+"([^"]*)"',b)
  if not nm: continue
  for _,_,nb in forms(b,r'^\s*\(node\s'):
   rr=re.search(r'\(ref\s+"([^"]+)"',nb); pp=re.search(r'\(pin\s+"([^"]+)"',nb)
   if rr and pp: out[f'{rr.group(1)}.{pp.group(1)}']=nm.group(1)
 return out

def observe(P):
 P=P.resolve(); sch=P/'ecc83-pp_v2.kicad_sch'
 with tempfile.TemporaryDirectory(prefix='aeb-eda-mut-obs-') as td:
  td=Path(td); erc=td/'erc.json'; net=td/'net.net'
  subprocess.run([K,'sch','erc','--format','json','--output',str(erc),str(sch)],cwd=P,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  q=subprocess.run([K,'sch','export','netlist','--format','kicadsexpr','--output',str(net),str(sch)],cwd=P,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  if q.returncode or not erc.exists() or not net.exists(): return {'providerOk':False}
  e=json.load(open(erc)); vs=[v for sh in e['sheets'] for v in sh.get('violations',[])]; electrical=[v for v in vs if v['type']!='footprint_link_issues']; nm=nmap(net.read_text()); vals={n:nm.get(n) for n in TARGET}; same=(None not in vals.values() and len(set(vals.values()))==1); return {'providerOk':True,'ercElectricalClean':not electrical,'targetNets':vals,'targetSameNet':same,'targetNetName':vals[TARGET[0]] if same else None}

def label_form(x,y,name,uuid):
 return f'''\t(label "{name}"\n\t\t(at {x} {y} 0)\n\t\t(effects\n\t\t\t(font\n\t\t\t\t(size 1.27 1.27)\n\t\t\t)\n\t\t\t(justify left bottom)\n\t\t)\n\t\t(uuid "{uuid}")\n\t)\n'''
def main():
 ap=argparse.ArgumentParser(); ap.add_argument('--source',required=True); ap.add_argument('--out',required=True); a=ap.parse_args(); SRC=Path(a.source).resolve(); sch=SRC/'ecc83-pp_v2.kicad_sch'; s=sch.read_text(); base=observe(SRC); assert base['providerOk'] and base['targetSameNet']; wires=list(forms(s,r'^\s*\(wire\s')); endpoints=[]
 for wi,(aa,bb,w) in enumerate(wires):
  u=re.search(r'\(uuid\s+"([^"]+)"',w); pts=re.findall(r'\(xy\s+([\-0-9.]+)\s+([\-0-9.]+)\)',w)
  for pi,p in enumerate(pts): endpoints.append((wi,pi,p[0],p[1],u.group(1) if u else None))
 uniq=[]; seen=set()
 for x in endpoints:
  key=(x[2],x[3])
  if key not in seen: seen.add(key); uniq.append(x)
 rows=[]; root=Path('/tmp/aeb-eda-mut-enum'); shutil.rmtree(root,ignore_errors=True); root.mkdir()
 anchor=s.index('\t(wire\n')
 for j,(wi,pi,x,y,wu) in enumerate(uniq):
  cid=f'label-{j:02d}'; P=root/cid; shutil.copytree(SRC,P); name=f'PROBE_LABEL_{j:02d}'; uuid=f'30000000-0000-4000-8000-{j:012d}'; mut=s[:anchor]+label_form(x,y,name,uuid)+s[anchor:]; (P/'ecc83-pp_v2.kicad_sch').write_text(mut); o=observe(P); rows.append({'id':cid,'kind':'add_local_label_at_wire_endpoint','args':{'x':x,'y':y,'name':name,'sourceWireUuid':wu},'observation':o})
 for j,(aa,bb,w) in enumerate(wires):
  cid=f'remove-wire-{j:02d}'; P=root/cid; shutil.copytree(SRC,P); u=re.search(r'\(uuid\s+"([^"]+)"',w); (P/'ecc83-pp_v2.kicad_sch').write_text(s[:aa]+s[bb:]); o=observe(P); rows.append({'id':cid,'kind':'remove_wire','args':{'wireUuid':u.group(1) if u else None},'observation':o})
 for r in rows:
  o=r['observation']; r['features']={'connectivityPreserved':o.get('targetSameNet') is True,'targetNetNameChanged':o.get('targetNetName')!=base['targetNetName'] if o.get('targetSameNet') else False,'ercElectricalClean':o.get('ercElectricalClean') is True}
 out={'schemaVersion':1,'kind':'ordivon.aeb.eda-mutation-probe-enumeration','provider':{'name':'KiCad','version':'10.0.5'},'baseline':base,'mutationGrammar':['add_local_label_at_wire_endpoint','remove_wire'],'candidateCount':len(rows),'candidates':rows,'boundary':'single-edit schematic mutation grammar over existing wire endpoints/wires only; observations are provider-derived, owner meaning not inferred'}; Path(a.out).write_text(json.dumps(out,indent=2,sort_keys=True)+'\n'); print('candidates',len(rows),'labels',len(uniq),'removeWires',len(wires));
 for r in rows:
  f=r['features']
  if f['connectivityPreserved'] and f['targetNetNameChanged'] and f['ercElectricalClean']: print('NAME_ONLY_DISCRIMINATOR',r['id'],r['args'],r['observation']['targetNetName'])
if __name__=='__main__': main()
