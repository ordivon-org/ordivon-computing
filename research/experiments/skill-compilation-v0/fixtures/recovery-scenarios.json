{
  "schemaVersion": 1,
  "kind": "ordivon.skill-recovery-scenarios",
  "scenarios": [
    {
      "id": "dev-exec-existing",
      "split": "development",
      "operationClass": "durable_exec",
      "facts": [
        "workspace.exec response was lost",
        "task.list for the exact clientRequestId returns an existing nonterminal Job"
      ],
      "available": [
        "task.list",
        "task.get",
        "task.observe",
        "workspace.exec"
      ],
      "oracle": [
        "observe_existing_job"
      ],
      "redispatch": false
    },
    {
      "id": "dev-exec-absent",
      "split": "development",
      "operationClass": "durable_exec",
      "facts": [
        "workspace.exec response was lost",
        "task.list for exact clientRequestId returns no Job",
        "workspace source state is unchanged"
      ],
      "available": [
        "task.list",
        "workspace.exec"
      ],
      "oracle": [
        "retry_same_client_request_after_absence"
      ],
      "redispatch": true
    },
    {
      "id": "dev-open",
      "split": "development",
      "operationClass": "workspace_open",
      "facts": [
        "workspace.open used explicit workspaceId ws-alpha",
        "response was lost"
      ],
      "available": [
        "workspace.get",
        "workspace.open"
      ],
      "oracle": [
        "inspect_workspace_by_id"
      ],
      "redispatch": false
    },
    {
      "id": "dev-patch",
      "split": "development",
      "operationClass": "workspace_patch",
      "facts": [
        "workspace.patch used clientRequestId patch-17",
        "response was lost"
      ],
      "available": [
        "workspace.patch.get",
        "workspace.patch",
        "workspace.read"
      ],
      "oracle": [
        "reconcile_patch_receipt"
      ],
      "redispatch": false
    },
    {
      "id": "dev-mutate-applied",
      "split": "development",
      "operationClass": "workspace_mutate",
      "facts": [
        "workspace.mutate response was lost",
        "exact read now shows intended bytes present"
      ],
      "available": [
        "workspace.read",
        "workspace.get",
        "workspace.mutate"
      ],
      "oracle": [
        "accept_observed_applied_state"
      ],
      "redispatch": false
    },
    {
      "id": "dev-mutate-absent",
      "split": "development",
      "operationClass": "workspace_mutate",
      "facts": [
        "workspace.mutate response was lost",
        "exact read proves target remains unchanged"
      ],
      "available": [
        "workspace.read",
        "workspace.mutate"
      ],
      "oracle": [
        "retry_after_state_proves_absence"
      ],
      "redispatch": true
    },
    {
      "id": "dev-host-checkpoint",
      "split": "development",
      "operationClass": "host_checkpoint",
      "facts": [
        "task.checkpoint response was lost",
        "original expectedRevision and exact checkpoint payload are retained"
      ],
      "available": [
        "task.resume",
        "task.checkpoint"
      ],
      "oracle": [
        "replay_identical_checkpoint_transition"
      ],
      "redispatch": true
    },
    {
      "id": "dev-external-effect",
      "split": "development",
      "operationClass": "external_effect_inside_exec",
      "facts": [
        "Runtime Job ran git push",
        "MCP response was lost after possible dispatch",
        "external remote state is unknown"
      ],
      "available": [
        "task.list",
        "task.get",
        "task.observe",
        "git_remote_observation",
        "workspace.exec"
      ],
      "oracle": [
        "reconcile_runtime_then_external_world"
      ],
      "redispatch": false
    },
    {
      "id": "dev-job-terminal",
      "split": "development",
      "operationClass": "durable_exec",
      "facts": [
        "workspace.execPlan response was lost",
        "task.get shows exact Job succeeded and resultAvailable=true"
      ],
      "available": [
        "task.get",
        "artifact.read",
        "workspace.execPlan"
      ],
      "oracle": [
        "consume_existing_job_result"
      ],
      "redispatch": false
    },
    {
      "id": "dev-close",
      "split": "development",
      "operationClass": "workspace_close",
      "facts": [
        "workspace.close used expectedSourceStateDigest",
        "response was lost",
        "close contract is replayable through closed tombstone"
      ],
      "available": [
        "workspace.close",
        "workspace.list"
      ],
      "oracle": [
        "replay_digest_fenced_close"
      ],
      "redispatch": true
    },
    {
      "id": "hold-exec-recovery",
      "split": "holdout",
      "operationClass": "durable_exec",
      "facts": [
        "an execBound request timed out at the caller UI",
        "the exact clientRequestId appears in task.list as succeeded"
      ],
      "available": [
        "task.list",
        "task.get",
        "artifact.read",
        "workspace.execBound"
      ],
      "oracle": [
        "consume_existing_job_result"
      ],
      "redispatch": false
    },
    {
      "id": "hold-open-present",
      "split": "holdout",
      "operationClass": "workspace_open",
      "facts": [
        "explicit workspaceId ws-held was used",
        "tool transport returned UNKNOWN",
        "workspace.get(ws-held) now returns a healthy Workspace"
      ],
      "available": [
        "workspace.get",
        "workspace.open"
      ],
      "oracle": [
        "accept_existing_workspace"
      ],
      "redispatch": false
    },
    {
      "id": "hold-patch-prepared",
      "split": "holdout",
      "operationClass": "workspace_patch",
      "facts": [
        "patch call response disappeared",
        "patch.get can reconcile prepared/committed/unknown receipt state"
      ],
      "available": [
        "workspace.patch.get",
        "workspace.patch",
        "workspace.read"
      ],
      "oracle": [
        "reconcile_patch_receipt"
      ],
      "redispatch": false
    },
    {
      "id": "hold-checkpoint-existing",
      "split": "holdout",
      "operationClass": "host_checkpoint",
      "facts": [
        "checkpoint response disappeared",
        "replaying identical transition can converge with admission=existing"
      ],
      "available": [
        "task.checkpoint",
        "task.resume"
      ],
      "oracle": [
        "replay_identical_checkpoint_transition"
      ],
      "redispatch": true
    },
    {
      "id": "hold-side-effect",
      "split": "holdout",
      "operationClass": "external_effect_inside_exec",
      "facts": [
        "a Runtime process may have created a remote release tag before transport loss",
        "Runtime delivery status alone cannot prove whether the external tag exists"
      ],
      "available": [
        "task.get",
        "remote_tag_observation",
        "workspace.exec"
      ],
      "oracle": [
        "reconcile_runtime_then_external_world"
      ],
      "redispatch": false
    }
  ]
}
