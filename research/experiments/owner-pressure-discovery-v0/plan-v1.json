    "candidateFalsePromotionsNoGreaterThanBaseline": true,
    "candidateClassificationAccuracyWithinBaseline": 0.10,
    "maxCandidateToBaselineTokenRatio": 1.50,
    "maxAverageDevelopmentInspections": 3.0,
    "maxAverageHoldoutInspections": 2.0
  },
  "authority": {
    "ownerFacts": "frozen exact-revision evidence only",
    "candidateMay": ["inspect bounded evidence", "classify pressure", "propose research falsifier"],
    "candidateMayNot": ["change owner truth", "promote Core", "merge product source", "deploy", "define its own oracle"],
    "evaluator": "hidden deterministic owner-bound oracle"
  },
  "forbiddenInfrastructure": ["pressure daemon", "central owner-state registry", "automatic research scheduler", "automatic evaluator service", "automatic promoter", "Skill/Multi/Graph/Organization layer by category"],
  "stopCondition": "One valid development plus frozen holdout campaign decides this representation. Do not tune a v2 evaluator merely to obtain promotion."
