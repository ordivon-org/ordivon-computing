{
  "schemaVersion": 1,
  "kind": "ordivon.owner-pressure-discovery-plan",
  "planId": "PRESSURE-C6-001",
  "status": "frozen_before_live_provider",
  "treatments": {
    "full-evidence-baseline": "one structured Provider call with all frozen evidence cards",
    "selective-inspection": "same Provider/model receives metadata inventory and may inspect at most 3 development or 2 holdout evidence cards before submit"
  },
  "replicates": {"development": 5, "holdout": 3},
  "promotionRule": {
