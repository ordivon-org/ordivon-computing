#!/usr/bin/env bash
set -euo pipefail

systemctl start ordivon-mlflow.service
for _ in $(seq 1 120); do
  if curl -fsS http://127.0.0.1:5050/health >/dev/null; then
    printf '%s\n' 'MLflow UI: http://127.0.0.1:5050'
    exit 0
  fi
  sleep 0.25
done
systemctl status --no-pager ordivon-mlflow.service >&2 || true
exit 1
