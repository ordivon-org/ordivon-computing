#!/usr/bin/env bash
set -euo pipefail

install_root=/opt/ordivon/evaluation-data-plane
binary="$install_root/current/source/.venv/bin/ordivon-eval-data"

systemctl is-enabled --quiet ordivon-evaluation-project.timer
systemctl is-enabled --quiet ordivon-evaluation-backup.timer

"$binary" status \
  --evaluation-root /var/lib/ordivon/analytics/evaluation \
  --tracking-uri sqlite:////var/lib/ordivon/analytics/mlflow/mlflow.db \
  --mlflow-database /var/lib/ordivon/analytics/mlflow/mlflow.db \
  --repository /root/backups/ordivon-evaluation-data-plane-restic \
  --password-file /root/.config/ordivon/secrets/restic-evaluation-data-plane
