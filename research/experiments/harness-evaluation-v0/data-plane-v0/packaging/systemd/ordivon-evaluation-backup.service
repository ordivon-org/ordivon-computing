[Unit]
Description=Back up and restore-check the Ordivon evaluation data plane
After=ordivon-evaluation-project.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ordivon/evaluation-data-plane.env
ExecStart=/opt/ordivon/evaluation-data-plane/current/source/.venv/bin/ordivon-eval-data backup --evaluation-root /var/lib/ordivon/analytics/evaluation --mlflow-database /var/lib/ordivon/analytics/mlflow/mlflow.db --mlflow-artifacts /var/lib/ordivon/analytics/mlflow/artifacts --staging-root /var/lib/ordivon/analytics/backup-staging --repository /root/backups/ordivon-evaluation-data-plane-restic --password-file /root/.config/ordivon/secrets/restic-evaluation-data-plane
ExecStart=/opt/ordivon/evaluation-data-plane/current/source/.venv/bin/ordivon-eval-data restore-check --repository /root/backups/ordivon-evaluation-data-plane-restic --password-file /root/.config/ordivon/secrets/restic-evaluation-data-plane
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/ordivon/analytics/evaluation /var/lib/ordivon/analytics/mlflow
ReadWritePaths=/var/lib/ordivon/analytics/backup-staging /root/backups/ordivon-evaluation-data-plane-restic
RestrictAddressFamilies=AF_UNIX
