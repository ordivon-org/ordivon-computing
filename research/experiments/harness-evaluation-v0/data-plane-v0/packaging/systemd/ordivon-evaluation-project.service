[Unit]
Description=Project Ordivon evaluation evidence into DuckDB, Parquet, and MLflow
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ordivon/evaluation-data-plane.env
Environment=MLFLOW_DISABLE_TELEMETRY=true
ExecStart=/opt/ordivon/evaluation-data-plane/current/source/.venv/bin/ordivon-eval-data project --source-root /var/lib/ordivon/analytics/source/current --output-root /var/lib/ordivon/analytics/evaluation
ExecStart=/opt/ordivon/evaluation-data-plane/current/source/.venv/bin/ordivon-eval-data mirror --output-root /var/lib/ordivon/analytics/evaluation --tracking-uri sqlite:////var/lib/ordivon/analytics/mlflow/mlflow.db --artifact-location file:///var/lib/ordivon/analytics/mlflow/artifacts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/ordivon/analytics/source
ReadWritePaths=/var/lib/ordivon/analytics/evaluation /var/lib/ordivon/analytics/mlflow
RestrictAddressFamilies=AF_UNIX
