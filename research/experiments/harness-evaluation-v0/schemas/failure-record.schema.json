{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/evaluation/failure-record-v1.json",
  "title": "Ordivon Evaluation Failure Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "failureId",
    "trialId",
    "failureClass",
    "failureCode",
    "firstObservableEvent",
    "responsibleBoundary",
    "recoverable",
    "recovered",
    "duplicateEffect",
    "humanIntervention",
    "description",
    "minimalCorrection",
    "correctionCost",
    "evidenceRefs",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.evaluation-failure"},
    "failureId": {"type": "string", "minLength": 1},
    "trialId": {"type": "string", "minLength": 1},
    "failureClass": {
      "type": "string",
      "enum": ["CONTEXT", "MODEL", "TOOL", "EFFECT", "HARNESS", "VERIFIER", "ENVIRONMENT"]
    },
    "failureCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "firstObservableEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "eventKind", "evidenceRef"],
      "properties": {
        "sequence": {"type": ["integer", "null"], "minimum": 1},
        "eventKind": {"type": "string", "minLength": 1},
        "evidenceRef": {"type": "string", "minLength": 1}
      }
    },
    "responsibleBoundary": {
      "type": "string",
      "enum": ["context", "model", "tool", "effect", "harness", "verifier", "environment", "host", "runtime", "provider", "operator"]
    },
    "recoverable": {"type": "boolean"},
    "recovered": {"type": "boolean"},
    "duplicateEffect": {"type": "boolean"},
    "humanIntervention": {"type": "boolean"},
    "description": {"type": "string", "minLength": 1},
    "minimalCorrection": {"type": "string", "minLength": 1},
    "correctionCost": {"type": ["string", "null"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ordivon-canonical-json-v1"},
        "payloadDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
