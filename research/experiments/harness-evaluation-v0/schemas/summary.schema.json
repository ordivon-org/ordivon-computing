{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/evaluation/summary-v1.json",
  "title": "Ordivon Evaluation Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "summaryId", "generatedAt", "suite", "source", "inventory", "groups", "comparisonCandidates", "policy", "limitations", "integrity"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.evaluation-summary"},
    "summaryId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "suite": {"$ref": "#/$defs/fileRef"},
    "source": {"type": "object"},
    "inventory": {"type": "object"},
    "groups": {"type": "array"},
    "comparisonCandidates": {"type": "array"},
    "policy": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ordivon-evidence-json-v1"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
