{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/evaluation/suite-v1.json",
  "title": "Ordivon Evaluation Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "suiteId", "suiteVersion", "purpose", "workloadFamilies", "comparisonPolicy", "metrics", "integrity"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.evaluation-suite"},
    "suiteId": {"type": "string", "minLength": 1},
    "suiteVersion": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "workloadFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "status", "priority", "validatedTaskCount", "targetTaskCount", "taskRefs", "targetFailureCodes", "admissionEvidenceRefs", "limitations"],
        "properties": {
          "familyId": {"type": "string", "minLength": 1},
          "status": {"enum": ["admitted", "candidate", "historical_only", "blocked"]},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "validatedTaskCount": {"type": "integer", "minimum": 0},
          "targetTaskCount": {"type": "integer", "minimum": 0},
          "taskRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repositoryId", "taskId", "taskVersion", "path", "digest"],
              "properties": {
                "repositoryId": {"type": "string", "minLength": 1},
                "taskId": {"type": "string", "minLength": 1},
                "taskVersion": {"type": "integer", "minimum": 1},
                "path": {"type": "string", "minLength": 1},
                "digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
              }
            }
          },
          "targetFailureCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "admissionEvidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "comparisonPolicy": {"type": "object"},
    "metrics": {"type": "object"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ordivon-evidence-json-v1"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
