{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/evaluation/system-manifest-v1.json",
  "title": "Ordivon Evaluation System Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "manifestId", "capturedAt", "systemSnapshot", "evaluationContract", "configuration", "privacy", "unavailableFields", "limitations", "integrity"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.evaluation-system-manifest"},
    "manifestId": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "format": "date-time"},
    "systemSnapshot": {"$ref": "#/$defs/fileRef"},
    "evaluationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskSchema", "trialSchema", "resultSchema", "failureSchema", "failureTaxonomy", "suite", "graderSet"],
      "properties": {
        "taskSchema": {"$ref": "#/$defs/fileRef"},
        "trialSchema": {"$ref": "#/$defs/fileRef"},
        "resultSchema": {"$ref": "#/$defs/fileRef"},
        "failureSchema": {"$ref": "#/$defs/fileRef"},
        "failureTaxonomy": {"$ref": "#/$defs/fileRef"},
        "suite": {"$ref": "#/$defs/fileRef"},
        "graderSet": {"oneOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "digests"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "modelId", "modelRevision", "adapterRevision"],
          "properties": {
            "providerId": {"type": ["string", "null"]},
            "modelId": {"type": ["string", "null"]},
            "modelRevision": {"type": ["string", "null"]},
            "adapterRevision": {"type": ["string", "null"]}
          }
        },
        "digests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promptSet", "contextPolicy", "toolCatalog", "toolGrant", "budgetProfile", "environment"],
          "properties": {
            "promptSet": {"$ref": "#/$defs/nullableDigest"},
            "contextPolicy": {"$ref": "#/$defs/nullableDigest"},
            "toolCatalog": {"$ref": "#/$defs/nullableDigest"},
            "toolGrant": {"$ref": "#/$defs/nullableDigest"},
            "budgetProfile": {"$ref": "#/$defs/nullableDigest"},
            "environment": {"$ref": "#/$defs/nullableDigest"}
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretsIncluded", "rawReasoningRequired"],
      "properties": {
        "secretsIncluded": {"const": false},
        "rawReasoningRequired": {"const": false}
      }
    },
    "unavailableFields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ordivon-evidence-json-v1"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
