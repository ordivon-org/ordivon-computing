{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/evaluation/p0-closeout-v1.json",
  "title": "Ordivon Evaluation P0 Closeout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "closeoutId", "capturedAt", "baseRevision", "implementationBranch", "implementationRevisions", "testedRevision", "conformance", "artifacts", "results", "integration", "nextGate", "limitations", "integrity"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.evaluation-p0-closeout"},
    "closeoutId": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "format": "date-time"},
    "baseRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementationBranch": {"type": "string", "minLength": 1},
    "implementationRevisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "testedRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "conformance": {"type": "object"},
    "artifacts": {"type": "object"},
    "results": {"type": "object"},
    "integration": {"type": "object"},
    "nextGate": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ordivon-evidence-json-v1"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
