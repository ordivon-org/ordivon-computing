  "faultCells": [
    {
      "cellId": "HOST-STALE-ASSIGNMENT",
      "deterministic": true,
      "expected": "Host rejects it before acceptance and dispatches no new Runtime work",
      "forbidden": "Task advances or TaskOutcome is created",
      "injection": "Submit a completion proposal from an obsolete Assignment generation",
      "owner": "ordivon-host"
    },
    {
      "cellId": "HOST-MISSING-ARTIFACT",
      "deterministic": true,
      "expected": "Host rejects completion and preserves Runtime success as physical evidence only",
      "forbidden": "Process success becomes semantic completion",
      "injection": "Return a physically successful Runtime Job without the required completion Artifact",
      "owner": "ordivon-host"
    },
    {
      "cellId": "HARNESS-INVALID-TOOL-CORRECTION",
      "deterministic": true,
      "expected": "Invalid call is retained and not dispatched; corrected call may proceed",
      "forbidden": "Malformed arguments reach Runtime or vanish from the Trace",
      "injection": "Emit malformed Runtime Tool arguments followed by one corrected Tool call",
      "owner": "ordivon-harness"
    },
    {
      "cellId": "RUNTIME-RESPONSE-LOSS-REPLAY",
      "deterministic": true,
      "expected": "Fresh caller locates one Job and exact replay returns the same Job and Attempt",
      "forbidden": "A second physical dispatch occurs",
      "injection": "Lose the client response after Runtime admission",
      "owner": "ordivon-runtime"
    },
    {
      "cellId": "CROSS-RESTART-AFTER-RUN",
      "deterministic": true,
      "expected": "Fresh process reconstructs native evidence and commits at most one decision and TaskOutcome",
      "forbidden": "Provider Session memory, copied transcript, duplicate decision, or duplicate effect is required",
      "injection": "Stop the Host/Harness process after durable Run receipt and before final Host decision",
      "owner": "cross_layer"
    }
  ],
