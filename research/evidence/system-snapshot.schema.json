{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zycxfyh/agent-native-computing/research/evidence/system-snapshot.schema.json",
  "title": "Agent-Native Computing System Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "capturedAt",
    "purpose",
    "repositories",
    "services",
    "contracts",
    "artifacts",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "revision", "clean"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "clean": {"const": true}
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "binaryDigest", "observedState"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "executable": {"type": "string", "minLength": 1},
          "binaryDigest": {"$ref": "#/$defs/digest"},
          "unitDigest": {"$ref": "#/$defs/digest"},
          "observedState": {
            "enum": ["active", "inactive", "failed", "unknown"]
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"},
          "path": {"type": "string", "minLength": 1},
          "producedBy": {"type": "string", "minLength": 1}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "json-sort-keys-v1"},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
